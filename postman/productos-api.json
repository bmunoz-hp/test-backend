{
  "info": {
    "name": "Prueba Técnica - Backend API (Productos, Categorías y Ventas)",
    "description": "Colección completa para probar las APIs de Productos, Categorías y Ventas en NestJS con variables de entorno local y ejemplos reales de peticiones.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Categorías",
      "item": [
        {
          "name": "1. Crear Categoría",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Electrónica\",\n  \"descripcion\": \"Dispositivos y accesorios tecnológicos\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": ["{{baseUrl}}"],
              "path": ["categories"]
            },
            "description": "Crea una nueva categoría en el sistema. Devuelve 201 en éxito."
          }
        },
        {
          "name": "2. Obtener Todas las Categorías",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": ["{{baseUrl}}"],
              "path": ["categories"]
            },
            "description": "Obtiene la lista completa de categorías registradas."
          }
        },
        {
          "name": "3. Obtener Categoría por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories/{{category_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["categories", "{{category_id}}"]
            },
            "description": "Busca una categoría específica por su UUID."
          }
        },
        {
          "name": "4. Actualizar Categoría por ID",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descripcion\": \"Dispositivos, accesorios y componentes tecnológicos\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/categories/{{category_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["categories", "{{category_id}}"]
            },
            "description": "Actualiza parcialmente el nombre o la descripción de una categoría."
          }
        },
        {
          "name": "5. Eliminar Categoría por ID",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories/{{category_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["categories", "{{category_id}}"]
            },
            "description": "Elimina una categoría del sistema por su UUID."
          }
        }
      ]
    },
    {
      "name": "Productos",
      "item": [
        {
          "name": "1. Crear Producto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Teclado Mecánico RGB\",\n  \"price\": 129.99,\n  \"stock\": 50,\n  \"categoryId\": \"{{category_id}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/productos/create",
              "host": ["{{baseUrl}}"],
              "path": ["productos", "create"]
            },
            "description": "Crea un nuevo producto vinculado a una categoría mediante `categoryId`."
          }
        },
        {
          "name": "2. Obtener Productos Paginados",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos/list?page=1&limit=10&search=",
              "host": ["{{baseUrl}}"],
              "path": ["productos", "list"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Número de página"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Registros por página"
                },
                {
                  "key": "search",
                  "value": "",
                  "description": "Filtro de búsqueda opcional"
                }
              ]
            },
            "description": "Devuelve la lista paginada de productos incluyendo su categoría asociada."
          }
        },
        {
          "name": "3. Obtener Producto por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos/{{producto_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["productos", "{{producto_id}}"]
            },
            "description": "Busca un producto por su UUID devuelto junto con su categoría."
          }
        },
        {
          "name": "4. Actualizar Producto por ID",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 99.99,\n  \"stock\": 45,\n  \"categoryId\": \"{{category_id}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/productos/{{producto_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["productos", "{{producto_id}}"]
            },
            "description": "Actualiza parcialmente un producto existente o le asigna/cambia la categoría."
          }
        },
        {
          "name": "5. Eliminar Producto por ID",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos/{{producto_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["productos", "{{producto_id}}"]
            },
            "description": "Elimina un producto por su UUID."
          }
        }
      ]
    },
    {
      "name": "Ventas",
      "item": [
        {
          "name": "1. Registrar Venta y Descontar Stock",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{producto_id}}\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sales/create",
              "host": ["{{baseUrl}}"],
              "path": ["sales", "create"]
            },
            "description": "Registra una transacción de venta descontando el stock del producto de forma atómica."
          }
        },
        {
          "name": "2. Obtener Ventas Paginadas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sales/list?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["sales", "list"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Número de página"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Registros por página"
                }
              ]
            },
            "description": "Obtiene la lista paginada de ventas junto con sus detalles e información de producto."
          }
        },
        {
          "name": "3. Obtener Venta por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sales/{{sale_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["sales", "{{sale_id}}"]
            },
            "description": "Busca los detalles de una venta específica por su UUID."
          }
        },
        {
          "name": "4. Cambiar Estado de una Venta",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"COMPLETED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sales/{{sale_id}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["sales", "{{sale_id}}", "status"]
            },
            "description": "Actualiza el estado de una venta (COMPLETED, PENDING, CANCELED)."
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "producto_id",
      "value": "123e4567-e89b-12d3-a456-426614174000",
      "type": "string"
    },
    {
      "key": "category_id",
      "value": "a48b5678-e89b-12d3-a456-426614174000",
      "type": "string"
    },
    {
      "key": "sale_id",
      "value": "998b5678-e89b-12d3-a456-426614174000",
      "type": "string"
    }
  ]
}

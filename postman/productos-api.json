{
  "info": {
    "name": "Productos API (NestJS)",
    "description": "Colección para probar el CRUD de Productos en NestJS.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Productos",
      "item": [
        {
          "name": "Crear Producto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Teclado Mecánico\",\n  \"precio\": 99.99,\n  \"stock\": 10\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": ["{{baseUrl}}"],
              "path": ["productos"]
            }
          }
        },
        {
          "name": "Obtener Todos los Productos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": ["{{baseUrl}}"],
              "path": ["productos"]
            }
          }
        },
        {
          "name": "Obtener Producto por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos/{{producto_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["productos", "{{producto_id}}"]
            }
          }
        },
        {
          "name": "Actualizar Producto",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"precio\": 89.99\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/productos/{{producto_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["productos", "{{producto_id}}"]
            }
          }
        },
        {
          "name": "Eliminar Producto",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos/{{producto_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["productos", "{{producto_id}}"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "producto_id",
      "value": "aqui-va-el-id-creado",
      "type": "string"
    }
  ]
}

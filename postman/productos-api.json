{
  "info": {
    "name": "Productos API (NestJS)",
    "description": "Colección actualizada para probar el CRUD de Productos. Incluye cuerpos de ejemplo y validaciones.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Productos",
      "item": [
        {
          "name": "Crear Producto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Teclado Mecánico RGB\",\n  \"precio\": 129.99,\n  \"stock\": 50\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": ["{{baseUrl}}"],
              "path": ["productos"]
            },
            "description": "Crea un nuevo producto en la base de datos. Requiere nombre (string), precio (number positivo) y stock (number positivo)."
          }
        },
        {
          "name": "Obtener Todos los Productos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": ["{{baseUrl}}"],
              "path": ["productos"]
            },
            "description": "Devuelve la lista completa de productos registrados."
          }
        },
        {
          "name": "Obtener Producto por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos/{{producto_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["productos", "{{producto_id}}"]
            },
            "description": "Busca un producto por su UUID. Si no existe, devuelve 404 NotFound."
          }
        },
        {
          "name": "Actualizar Producto",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"precio\": 99.99,\n  \"stock\": 45\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/productos/{{producto_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["productos", "{{producto_id}}"]
            },
            "description": "Actualiza parcialmente un producto. Todos los campos son opcionales pero se validan si se envían."
          }
        },
        {
          "name": "Eliminar Producto",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos/{{producto_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["productos", "{{producto_id}}"]
            },
            "description": "Elimina un producto por su UUID. Devuelve el producto eliminado o 404 si no existe."
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "producto_id",
      "value": "123e4567-e89b-12d3-a456-426614174000",
      "type": "string"
    }
  ]
}

{
  "info": {
    "name": "Prueba Técnica - Productos API",
    "description": "Colección para probar el CRUD de Productos en NestJS",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Productos",
      "item": [
        {
          "name": "1. Crear Producto",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Teclado Mecánico\",\n  \"precio\": 150.50,\n  \"stock\": 10\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": ["{{baseUrl}}"],
              "path": ["productos"]
            }
          }
        },
        {
          "name": "2. Obtener Todos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": ["{{baseUrl}}"],
              "path": ["productos"]
            }
          }
        },
        {
          "name": "3. Obtener Uno por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos/{{producto_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["productos", "{{producto_id}}"]
            }
          }
        },
        {
          "name": "4. Actualizar Producto",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"precio\": 120.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/productos/{{producto_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["productos", "{{producto_id}}"]
            }
          }
        },
        {
          "name": "5. Eliminar Producto",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos/{{producto_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["productos", "{{producto_id}}"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "producto_id",
      "value": "pega-aqui-el-uuid-generado",
      "type": "string"
    }
  ]
}

{
  "info": {
    "name": "Productos API (NestJS)",
    "description": "Colección completa para probar el CRUD de Productos sincronizada con las rutas y decoradores Swagger del controlador.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Productos",
      "item": [
        {
          "name": "Crear Producto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Teclado Mecánico RGB\",\n  \"precio\": 129.99,\n  \"stock\": 50\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/productos/create",
              "host": ["{{baseUrl}}"],
              "path": ["productos", "create"]
            },
            "description": "Crea un nuevo producto en la base de datos (201 Created)."
          }
        },
        {
          "name": "Obtener Todos los Productos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos/list",
              "host": ["{{baseUrl}}"],
              "path": ["productos", "list"]
            },
            "description": "Devuelve la lista completa de productos registrados (200 OK)."
          }
        },
        {
          "name": "Obtener Producto por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos/{{producto_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["productos", "{{producto_id}}"]
            },
            "description": "Busca un producto por su UUID en la base de datos (200 OK / 400 BadRequest / 404 NotFound)."
          }
        },
        {
          "name": "Actualizar Producto",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"precio\": 99.99,\n  \"stock\": 45\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/productos/{{producto_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["productos", "{{producto_id}}"]
            },
            "description": "Actualiza parcialmente un producto existente por su UUID."
          }
        },
        {
          "name": "Eliminar Producto",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos/{{producto_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["productos", "{{producto_id}}"]
            },
            "description": "Elimina un producto por su UUID (200 OK / 400 BadRequest / 404 NotFound)."
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "producto_id",
      "value": "123e4567-e89b-12d3-a456-426614174000",
      "type": "string"
    }
  ]
}
